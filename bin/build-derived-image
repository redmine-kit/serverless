#!/usr/bin/env bash
# Builds a derived image with the plugins and themes of redmine.json
# (image.plugins and image.themes; docs/architecture.md#derived-images) on top
# of a base image, as an arm64 single-architecture image (image/derived).
# bin/deploy runs it when the lists are not empty.
#   bin/build-derived-image <redmine.json> <base image> [tag]   # default tag: serverless-derived:local
# Git sources are fetched by BuildKit at a tag (refs/tags/<ref>) or a full
# commit hash of a public HTTPS repository, so a branch or a repository that
# needs credentials is refused. Directories are relative to redmine.json.
# Bundler's credential for GitHub Packages comes from
# BUNDLE_RUBYGEMS__PKG__GITHUB__COM, or from the gh login when gh is there,
# and goes to the build as a secret.
# jq programs are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail

if [[ $# -lt 2 || ! -f "$1" ]]; then
  echo "usage: bin/build-derived-image <redmine.json> <base image> [tag]" >&2
  exit 64
fi
config_dir=$(cd "$(dirname "$1")" && pwd)
config="$config_dir/$(basename "$1")" base="$2" tag="${3:-serverless-derived:local}"
cd "$(dirname "$0")/.."

# Each name once, among the plugins and among the themes.
for kind in plugins themes; do
  duplicate=$(jq -r --arg kind "$kind" '[.image[$kind] // [] | .[].name] | group_by(.) | map(select(length > 1) | .[0]) | join(" ")' "$config")
  if [[ -n "$duplicate" ]]; then
    echo "image.$kind: listed more than once: $duplicate" >&2
    exit 65
  fi
done

context=$(mktemp -d) empty=$(mktemp -d)
trap 'rm -rf "$context" "$empty"' EXIT
mkdir -p "$context/plugins" "$context/themes"
: >"$context/Gemfile.plugins"
: >"$context/gems"

# A Git repository at a tag or commit, exported into a directory without .git.
# No credentials are passed: a repository that needs them is not fetched.
fetch_git() { # <kind> <name> <url> <ref> <directory>
  local ref="$4"
  [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || ref="refs/tags/$ref"
  if ! printf 'FROM scratch\nCOPY --from=source / /\n' |
    docker buildx build --quiet --build-context "source=$3#$ref" --output "type=local,dest=$5" -f - "$empty" \
      >/dev/null 2>"$context/git.err"; then
    sed 's/^/  /' "$context/git.err" | tail -n 5 >&2
    echo "image.$1 $2: $3 could not be fetched at the tag or commit $4." >&2
    echo "A Git entry must be a public HTTPS repository, and ref a tag or a full commit hash." >&2
    echo "For a private repository, check it out next to redmine.json and give it as path." >&2
    exit 67
  fi
  rm -f "$context/git.err"
}
# A directory next to redmine.json, without .git.
copy_dir() { # <path> <directory>
  local source="$config_dir/$1"
  if [[ ! -d "$source" ]]; then
    echo "$1: not a directory (relative to $config_dir)" >&2
    exit 66
  fi
  mkdir -p "$2"
  tar -C "$source" --exclude=.git -cf - . | tar -C "$2" -xf -
}

# One line per plugin or theme, the fields separated by US (0x1f), which
# keeps empty fields.
while IFS=$'\x1f' read -r kind name version source git ref path; do
  dest="$context/$kind/$name"
  if [[ -n "$version" ]]; then
    echo "$kind/$name: gem $version${source:+ from $source}"
    line="gem '$name', '= $version', require: false"
    if [[ -n "$source" ]]; then
      printf "source '%s' do\n  %s\nend\n" "$source" "$line" >>"$context/Gemfile.plugins"
    else
      printf '%s\n' "$line" >>"$context/Gemfile.plugins"
    fi
    echo "$name" >>"$context/gems"
  elif [[ -n "$git" ]]; then
    echo "$kind/$name: $git at $ref"
    fetch_git "$kind" "$name" "$git" "$ref" "$dest"
  else
    echo "$kind/$name: $path"
    copy_dir "$path" "$dest"
  fi
done < <(jq -r '(.image.plugins // [] | .[] | ["plugins"] + [.name, .version, .source, .git, .ref, .path]),
  (.image.themes // [] | .[] | ["themes"] + [.name, null, null, .git, .ref, .path])
  | map(. // "") | join("\u001f")' "$config")

secret=()
if [[ -z "${BUNDLE_RUBYGEMS__PKG__GITHUB__COM:-}" ]] && command -v gh >/dev/null && gh auth token >/dev/null 2>&1; then
  BUNDLE_RUBYGEMS__PKG__GITHUB__COM="x-access-token:$(gh auth token)"
fi
if [[ -n "${BUNDLE_RUBYGEMS__PKG__GITHUB__COM:-}" ]]; then
  export BUNDLE_RUBYGEMS__PKG__GITHUB__COM
  secret=(--secret "id=bundle_github,env=BUNDLE_RUBYGEMS__PKG__GITHUB__COM")
fi
docker buildx build --platform linux/arm64 --provenance=false --sbom=false ${secret[@]+"${secret[@]}"} \
  --build-context derived=image/derived --build-arg "BASE_IMAGE=$base" --load -t "$tag" \
  -f image/derived/Dockerfile "$context"
