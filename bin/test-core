#!/usr/bin/env bash
# Redmine's own tests (docs/testing.md#redmines-own-tests): unit,
# functional and integration tests of Redmine with this image's configuration
# and gems, on the PostgreSQL of bin/test-services, in Apple container when it
# runs, else in Docker (CONTAINER_CLI=container|docker chooses). System tests
# are separate. The image does not write db/schema.rb after migrations (Lambda
# cannot), but parallel tests load it, so it is written here.
#   bin/test-core                      # all of them
#   bin/test-core test/unit/user_test.rb   # some files
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/lib/container.sh
. bin/lib/plugin.sh
. bin/lib/aws-emulator.sh
image=serverless-core-test

bin/test-services >/dev/null 2>&1 || bin/test-services
image_build --load -q -- --platform linux/arm64 ${build_secrets[@]+"${build_secrets[@]}"} \
  --build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}" -t "$image" --target core-test -f image/Dockerfile . >/dev/null

# Tests that fail with this image's gems for known reasons, as one pattern.
known=$(grep -v -e '^#' -e '^$' test/core/known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)

if [[ "$cli" == docker ]]; then
  workers="${PARALLEL_WORKERS:-$(getconf _NPROCESSORS_ONLN)}"
  opts=()
else
  # More memory than the 1 GB a container gets by default.
  workers="${PARALLEL_WORKERS:-2}"
  opts=(-m 4G -e TEST_DATABASE_HOST="$(postgres_host "$default_network")")
fi
"$cli" run --rm --network "$default_network" ${opts[@]+"${opts[@]}"} -e PARALLEL_WORKERS="$workers" "$image" \
  sh -c 'bin/rails db:drop db:create db:migrate redmine:plugins:migrate db:schema:dump >/dev/null && bin/rails test "$@"' test-core \
  --exclude "/^($known)\$/" "$@"
