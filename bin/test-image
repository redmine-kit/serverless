#!/usr/bin/env bash
# Image tests (docs/testing.md#image-tests). Starts the image under the same
# conditions as Lambda: a read-only file system with only /tmp writable, and
# a user that is not root. The database is the PostgreSQL of
# bin/test-services, and AWS (SSM and SQS) is its AWS Emulator; nothing is
# mocked. worker and task run on the Runtime Interface Emulator in the base
# image.
#   bin/test-image [image]          # default: serverless:test (bin/build-image)
#   bin/test-image <image> <redmine.json>
#                                   # a derived image (bin/build-derived-image), also
#                                   # checking the plugins and themes it adds
#   KEEP=1 bin/test-image [image]   # leave the containers for inspection
# Commands that run inside containers are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image="${1:-serverless:test}"
derived_config="${2:-}"
# The internal network of test/compose.yml: the containers reach PostgreSQL
# and AWS Emulator, but not AWS.
network=serverless-test_internal
prefix=serverless-image-test
# The emulator's certificate names only 127.0.0.1 and localhost, so every
# container reaches it on 127.0.0.1: the short-lived ones run in its network
# namespace, and each role in the namespace of a forwarder of its own
# (forwarder below), as the roles run side by side and each listens on 8080.
endpoint=https://127.0.0.1:9297
account=000000000000
queue_url="$endpoint/$account/redmine-jobs"
ssm_path=/image-test/env/
secret_key_base='image-test-only-secret-key-base'

. bin/lib/aws-emulator.sh
bin/test-services >/dev/null 2>&1 || bin/test-services
emulator=$(emulator)
echo "AWS for the image tests: $(docker exec "$emulator" aws-emulator --version | sed -n 's/^Version: /AWS Emulator /p')"
# The certificate, readable by the low-privilege user of the image: in the
# emulator's volume only its own user can read it.
ca_dir=$(mktemp -d)
chmod 755 "$ca_dir"
docker cp -q "$emulator:$emulator_ca" "$ca_dir/ca.pem"
chmod 644 "$ca_dir/ca.pem"

failures=0
quiet() { "$@" >/dev/null; }
pass() { echo "ok: $*"; }
fail() { echo "FAILED: $*" >&2; failures=$((failures + 1)); }
check() { local name="$1"; shift; if "$@"; then pass "$name"; else fail "$name"; fi; }

roles=(web worker task)
cleanup() {
  local role
  for role in "${roles[@]}"; do
    docker rm -f "$prefix-$role" "$prefix-$role-forwarder" >/dev/null 2>&1 || true
  done
}
trap '[[ -n "${KEEP:-}" ]] || { cleanup; rm -rf "$ca_dir"; }' EXIT
cleanup

# Same conditions as Lambda. The secrets come from SSM as on Lambda; the other
# settings go in as environment variables.
aws_env=(-e AWS_REGION=us-east-1 -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test
  -e AWS_ENDPOINT_URL="$endpoint" -v "$ca_dir/ca.pem:/etc/aws-emulator-ca.pem:ro"
  -e AWS_CA_BUNDLE=/etc/aws-emulator-ca.pem)
# The short-lived containers: in the emulator's network namespace.
at_emulator=(--network "container:$emulator")
# A role's network namespace on the internal network, where 127.0.0.1:9297 is
# forwarded to the emulator (TLS stays end to end), with Ruby from the image.
forwarder() { # <role>
  docker run -d --name "$prefix-$1-forwarder" --network "$network" --read-only --user 993:993 \
    --entrypoint ruby "$image" -rsocket -e '
      server = TCPServer.new("127.0.0.1", 9297)
      loop do
        Thread.new(server.accept) do |client|
          upstream = TCPSocket.new("aws-emulator", 9297)
          [[client, upstream], [upstream, client]].map do |from, to|
            Thread.new { IO.copy_stream(from, to) rescue nil; to.close_write rescue nil }
          end.each(&:join)
          [client, upstream].each(&:close)
        end
      end' >/dev/null
  for _ in $(seq 1 30); do
    docker exec "$prefix-$1-forwarder" ruby -rsocket -e 'TCPSocket.new("127.0.0.1", 9297).close' 2>/dev/null && return 0
    sleep 1
  done
  echo "the forwarder of $1 does not listen" >&2
  return 1
}
run() {
  local role="$1"; shift
  forwarder "$role"
  docker run -d --name "$prefix-$role" --network "container:$prefix-$role-forwarder" \
    --read-only --tmpfs /tmp:exec --user 993:993 \
    -e REDMINE_ROLE="$role" \
    -e REDMINE_DB_NAME=postgres -e REDMINE_DB_USERNAME=postgres -e REDMINE_DB_SSLMODE=disable \
    -e REDMINE_SSM_PATH="$ssm_path" "${aws_env[@]}" \
    -e REDMINE_JOBS_QUEUE_URL="$queue_url" \
    "$@" "$image" >/dev/null
}

# Waits until the emulator inside the container answers (any HTTP status).
wait_rie() {
  for _ in $(seq 1 30); do
    docker exec "$prefix-$1" curl -s -o /dev/null http://127.0.0.1:8080/ 2>/dev/null && return 0
    sleep 1
  done
  echo "the emulator in $prefix-$1 does not answer" >&2
  return 1
}

# Invokes a function on the emulator inside its container.
invoke() {
  docker exec "$prefix-$1" curl -sS -X POST -d "$2" \
    http://127.0.0.1:8080/2015-03-31/functions/function/invocations
}

# Runs a task and prints its output. Fails when the exit code is not 0.
task() {
  local response
  response=$(invoke task "$1")
  jq -j '.output // .errorMessage // ""' <<<"$response"
  [[ "$(jq -r '.exit_code // "none"' <<<"$response")" == 0 ]]
}

echo "== task handler unit tests"
# With the coverage of the handler in coverage/image.lcov (test/image/coverage.rb).
mkdir -p coverage/image
chmod a+rwx coverage/image
handler_tests() {
  docker run --rm --read-only --tmpfs /tmp --user 993:993 -v "$PWD/test/image:/test:ro" \
    -v "$PWD/coverage/image:/coverage" -e COVERAGE_FILE=/coverage/image.lcov \
    --entrypoint ruby "$image" -r/test/coverage.rb -r/var/task/handler.rb /test/task_handler_test.rb
}
check "task handler" handler_tests
ssm_tests() {
  docker run --rm --read-only --tmpfs /tmp --user 993:993 "${at_emulator[@]}" "${aws_env[@]}" \
    -w /var/task/redmine --entrypoint ruby "$image" \
    -rbundler/setup -rredmine_aws_ssm/loader plugins/redmine_aws_ssm/test/loader_test.rb
}
check "SSM loading (redmine_aws_ssm)" ssm_tests

echo "== contents"
check "arm64 Linux image" test "$(docker image inspect "$image" -f '{{.Os}}/{{.Architecture}}')" = linux/arm64
contents() {
  docker run --rm --read-only --tmpfs /tmp --user 993:993 --entrypoint sh "$image" -c "$1"
}
check "ImageMagick convert" contents 'convert -version | grep -q "ImageMagick 6"'
check "Ghostscript" contents 'gs --version >/dev/null'
check "Pandoc 3.8.3 or later" contents \
  'v=$(pandoc --version | sed -n "1s/^pandoc //p"); printf "3.8.3\n%s\n" "$v" | sort -V -C'
check "IPA Gothic font" contents 'test -r /usr/share/fonts/ipa-gothic-fonts/ipag.ttf'
check "Subversion client" contents 'svn --version --quiet >/dev/null'
check "Git client" contents 'git --version >/dev/null'
# Run as the low-privilege user, so File.readable? answers for that user.
check "everything readable by the low-privilege user" contents \
  'ruby -rfind -e "Find.find(%q(/var/task), %q(/opt)) { |f| ok = File.directory?(f) ? File.executable?(f) : File.readable?(f); abort(f) unless ok || File.symlink?(f) }"'
check "compiled assets" contents 'test -r /var/task/redmine/public/assets/.manifest.json'
check "the S3 plugin's upload script is in the assets" contents \
  'grep -q "s3_upload" /var/task/redmine/public/assets/.manifest.json'
check "tmp links to /tmp/redmine" contents 'test "$(readlink /var/task/redmine/tmp)" = /tmp/redmine'
unknown_role() {
  local code=0
  docker run --rm --read-only --tmpfs /tmp --user 993:993 -e REDMINE_ROLE=other "$image" >/dev/null 2>&1 || code=$?
  [[ "$code" == 64 ]]
}
check "unknown REDMINE_ROLE exits with 64" unknown_role

echo "== task"
"${compose[@]}" exec -T postgres psql -q -U postgres \
  -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public' >/dev/null 2>&1
# A new queue each run (SQS allows one PurgeQueue per 60 seconds).
sqs DeleteQueue "$(jq -nc --arg url "$queue_url" '{QueueUrl: $url}')" >/dev/null 2>&1 || true
sqs CreateQueue '{"QueueName":"redmine-jobs"}' >/dev/null
queue_attribute() { # <name>: prints the queue's attribute
  sqs GetQueueAttributes "$(jq -nc --arg url "$queue_url" --arg name "$1" '{QueueUrl: $url, AttributeNames: [$name]}')" |
    jq -r --arg name "$1" '.Attributes[$name]'
}
# The database host and the secrets in SSM, as the deployment puts them
# (PostgreSQL here does not check the password). The host is only there, so
# the roles reach the database only if SSM is read before Rails reads
# config/database.yml.
docker run --rm "${at_emulator[@]}" "${aws_env[@]}" -w /var/task/redmine --entrypoint ruby "$image" \
  -rbundler/setup -raws-sdk-ssm -e '
    ssm = Aws::SSM::Client.new
    { "SECRET_KEY_BASE" => ARGV[1], "REDMINE_DB_PASSWORD" => "unused" }.each do |name, value|
      ssm.put_parameter(name: "#{ARGV[0]}#{name}", value: value, type: "SecureString", overwrite: true)
    end
    ssm.put_parameter(name: "#{ARGV[0]}REDMINE_DB_HOST", value: "postgres", type: "String", overwrite: true)' "$ssm_path" "$secret_key_base"
run task
wait_rie task
check "AWS cannot be reached from the roles' network" aws_unreachable "$prefix-task"
check "rake db:migrate" quiet task '{"command":"rake","args":["db:migrate"]}'
check "rake redmine:plugins:migrate" quiet task '{"command":"rake","args":["redmine:plugins:migrate"]}'
check "rake redmine:load_default_data" \
  quiet task '{"command":"rake","args":["redmine:load_default_data"],"env":{"REDMINE_LANG":"ja"}}'
check "rake -T" quiet task '{"command":"rake","args":["-T"]}'
runner_counts_users() { task '{"command":"runner","args":["puts User.count"]}' | tail -n 1 | grep -qx 2; }
check "rails runner" runner_counts_users
from_ssm() {
  task '{"command":"runner","args":["puts Rails.application.secret_key_base == ENV[%q(SECRET_KEY_BASE)] && ENV[%q(REDMINE_DB_PASSWORD)] == %q(unused)"]}' |
    tail -n 1 | grep -qx true
}
check "the secrets come from SSM" from_ssm
plugins_loaded() {
  task '{"command":"runner","args":["puts %w[redmine_aws redmine_aws_lambda redmine_aws_sqs redmine_aws_ses redmine_aws_s3 redmine_aws_ssm].reject { |id| Redmine::Plugin.installed?(id) }.join(%q(,)).presence || %q(all)"]}' |
    tail -n 1 | grep -qx all
}
check "the plugins are loaded (base, Lambda, SQS, SES, S3, SSM)" plugins_loaded
runner_says_none() { # <Ruby expression that lists what is missing>
  local event output
  event=$(jq -nc --arg code "puts(($1).join(%q(,)).presence || %q(none))" '{command: "runner", args: [$code]}')
  output=$(task "$event" | tail -n 1)
  [[ "$output" == none ]] || { echo "  missing: $output" >&2; return 1; }
}
# Redmine finds the clients of the repository types allowed on Lambda
# (docs/lambda.md#repositories) and reads a repository of each type with them,
# as the Lambda user: one made in /tmp with a file in it, read through
# Redmine's adapter (entries and revisions).
check "Redmine finds the Subversion and Git clients" runner_says_none \
  "%w[Subversion Git].reject { |type| Repository.const_get(type).scm_adapter_class.client_available }"
reads_repository() { # <Ruby code that makes the repository and returns its URL> <type> <path>
  local code event
  code='FileUtils.rm_rf(%q(/tmp/scm-test)); FileUtils.mkdir_p(%q(/tmp/scm-test/src))
    File.write(%q(/tmp/scm-test/src/README), %q(probe))
    url = begin
      '"$1"'
    end
    scm = Repository.const_get(ARGV[0]).new(url: url).scm
    puts [scm.entries(ARGV[1]).map(&:name).join, scm.revisions(%q(), nil, nil).size].join(%q( ))'
  event=$(jq -nc --arg code "$code" --arg type "$2" --arg path "$3" '{command: "runner", args: [$code, $type, $path]}')
  task "$event" | tail -n 1 | grep -qx 'README 1'
}
check "Redmine reads a Subversion repository" reads_repository \
  'system(*%w[svnadmin create /tmp/scm-test/svn], exception: true)
   system(*%w[svn import -q -m probe /tmp/scm-test/src file:///tmp/scm-test/svn/trunk], exception: true)
   %q(file:///tmp/scm-test/svn)' Subversion trunk
check "Redmine reads a Git repository" reads_repository \
  'git = %w[git -c user.name=probe -c user.email=probe@example.com]
   system(*git, *%w[-C /tmp/scm-test/src init -q -b main], exception: true)
   system(*git, *%w[-C /tmp/scm-test/src add README], exception: true)
   system(*git, *%w[-C /tmp/scm-test/src commit -q -m probe], exception: true)
   %q(/tmp/scm-test/src/.git)' Git ''
if [[ -n "$derived_config" ]]; then
  # image.plugins and image.themes of the derived image: loaded, their
  # migrations run by redmine:plugins:migrate above, and the themes' assets
  # compiled.
  added_plugins=$(jq -r '[.image.plugins // [] | .[].name] | join(" ")' "$derived_config")
  added_themes=$(jq -r '[.image.themes // [] | .[].name] | join(" ")' "$derived_config")
  if [[ -n "$added_plugins" ]]; then
    check "the added plugins are loaded ($added_plugins)" \
      runner_says_none "%w[$added_plugins].reject { |id| Redmine::Plugin.installed?(id) }"
    check "the added plugins' migrations have run" \
      runner_says_none "%w[$added_plugins].map { |id| Redmine::Plugin.find(id) }.select { |p| p.latest_migration && p.latest_migration != Redmine::Plugin::Migrator.current_version(p) }.map(&:id)"
  fi
  if [[ -n "$added_themes" ]]; then
    check "the added themes are found ($added_themes)" \
      runner_says_none "%w[$added_themes].reject { |id| Redmine::Themes.theme(id) }"
    for theme in $added_themes; do
      check "the assets of the theme $theme are compiled" contents \
        "grep -q '\"themes/$theme/application.css\"' /var/task/redmine/public/assets/.manifest.json"
    done
  fi
fi
rejected() { jq -e '.errorType == "Function<ArgumentError>"' <<<"$(invoke task "$1")" >/dev/null; }
check "env outside the allowed names is rejected" rejected '{"command":"rake","args":["-T"],"env":{"REDMINE_DB_HOST":"x"}}'
check "unknown command is rejected" rejected '{"command":"sh","args":["-c","id"]}'
failed_task() { invoke task '{"command":"rake","args":["no:such:task"]}' | jq -e '.exit_code != 0' >/dev/null; }
check "failed task returns its exit code" failed_task

echo "== web"
# Requests reach Puma as CloudFront sends them through the function URL: the
# function URL's host name in Host, the domain in X-Forwarded-Host and https
# in X-Forwarded-Proto (origin custom headers of infra/instance.yaml), with
# config.hosts set to the domain only (REDMINE_HOST; docs/lambda.md#host-and-scheme).
domain=redmine.example.test
function_url_host=abcdefghijklmnopqrstuvwxyz012345.lambda-url.us-east-1.on.aws
run web -e REDMINE_HOST="$domain"
web_curl() {
  docker exec "$prefix-web" curl -sS -H "Host: $function_url_host" -H "X-Forwarded-Host: $domain" \
    -H 'X-Forwarded-Proto: https' "$@"
}
web_up() {
  for _ in $(seq 1 60); do
    web_curl -f -o /dev/null http://127.0.0.1:3000/login 2>/dev/null && return 0
    sleep 1
  done
  docker logs "$prefix-web" 2>&1 | tail -20 >&2
  return 1
}
check "Puma starts and /login returns 200" web_up
# The page is read into a variable first: with grep -q in a pipe, curl can
# fail on a closed pipe, and pipefail counts that as a failure.
login_page() {
  local page
  page=$(web_curl -f http://127.0.0.1:3000/login) || return 1
  grep -q '<title>Redmine' <<<"$page"
}
check "login page is Redmine's" login_page
# Rails writes a Secure cookie only on HTTPS requests.
secure_cookie() {
  local headers
  headers=$(web_curl -f -D - -o /dev/null http://127.0.0.1:3000/login) || return 1
  grep -i '^set-cookie: _redmine_session=' <<<"$headers" | grep -qi '; secure'
}
check "the session cookie is Secure" secure_cookie
status_of() { # <curl arguments...>: prints the HTTP status
  docker exec "$prefix-web" curl -sS -o /dev/null -w '%{http_code}' -H 'X-Forwarded-Proto: https' "$@"
}
check "without X-Forwarded-Host, the function URL's host is blocked" \
  test "$(status_of -H "Host: $function_url_host" http://127.0.0.1:3000/login)" = 403
check "another X-Forwarded-Host is blocked" \
  test "$(status_of -H "Host: $function_url_host" -H 'X-Forwarded-Host: evil.example.net' http://127.0.0.1:3000/login)" = 403
check "the function URL's host as X-Forwarded-Host is blocked" \
  test "$(status_of -H "Host: $function_url_host" -H "X-Forwarded-Host: $function_url_host" http://127.0.0.1:3000/login)" = 403
redirects_to_domain() {
  local headers
  headers=$(web_curl -D - -o /dev/null http://127.0.0.1:3000/my/page) || return 1
  grep -qi "^location: https://$domain/login?back_url=https%3A%2F%2F$domain%2Fmy%2Fpage" <<<"$headers"
}
check "redirects use the domain" redirects_to_domain
# Signing in with the login form's POST: the session cookie and its CSRF
# token from the login page, and the browser's Origin. Redmine does not turn
# on Rails' origin check (forgery_protection_origin_check), so the token is
# what CSRF protection checks. The cookie is passed by hand: it is Secure, and
# curl does not send a Secure cookie over http://.
sign_in() { # <token, or empty for the page's>: prints the status and the Location of the POST
  local response cookie token
  response=$(web_curl -f -i http://127.0.0.1:3000/login) || return 1
  cookie=$(sed -n 's/^[Ss]et-[Cc]ookie: \(_redmine_session=[^;]*\).*/\1/p' <<<"$response" | head -n 1)
  token=${1:-$(sed -n 's/.*name="authenticity_token" value="\([^"]*\)".*/\1/p' <<<"$response" | head -n 1)}
  web_curl -o /dev/null -w '%{http_code} %{redirect_url}' -H "Cookie: $cookie" -H "Origin: https://$domain" \
    --data-urlencode "authenticity_token=$token" --data-urlencode username=admin --data-urlencode password=admin \
    http://127.0.0.1:3000/login
}
signs_in() { [[ "$(sign_in '')" == "302 https://$domain/my/page" ]]; }
check "signing in with the login form works with the domain" signs_in
wrong_token_rejected() { [[ "$(sign_in wrong-token)" == 422* ]]; }
check "a POST with a wrong CSRF token is rejected" wrong_token_rejected
# The favicon set in Redmine 7.1 (Administration › Settings › Display; here a
# PNG of one pixel), which CloudFront's /favicons/* behavior caches by its
# URL: Redmine answers it public and immutable for a year (Rails' 1.year,
# docs/lambda.md#the-favicon). Not on Redmine 7.0.
favicon=$(task '{"command":"runner","args":["if defined?(FaviconsController) then Setting.favicon = Setting.favicon_from_params(StringIO.new(Base64.decode64(%q(iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==)))); puts Setting.favicon[%q(digest)] else puts %q(none) end"]}' | tail -n 1)
if [[ "$favicon" == none ]]; then
  echo "skipped: the favicon of Redmine 7.1"
else
  favicon_served() {
    local headers
    headers=$(web_curl -f -D - -o /dev/null "http://127.0.0.1:3000/favicons/$favicon") || return 1
    grep -qi '^cache-control: max-age=31556952, public, immutable' <<<"$headers" &&
      grep -qi '^content-type: image/' <<<"$headers"
  }
  check "the favicon is served public and immutable" favicon_served
fi

echo "== worker"
run worker
wait_rie worker
job=$(task '{"command":"runner","args":["p = Project.create!(name: \"Worker probe\", identifier: \"worker-probe\"); Project.mark_for_deletion(p); puts DestroyProjectJob.new(p.id, 1, \"127.0.0.1\").serialize.to_json"]}' | tail -n 1)
# The job goes through the queue, and the worker gets it as Lambda's event
# source would pass it, with the receipt handle of the message received.
sqs SendMessage "$(jq -nc --arg url "$queue_url" --arg body "$job" '{QueueUrl: $url, MessageBody: $body}')" >/dev/null
received=$(sqs ReceiveMessage "$(jq -nc --arg url "$queue_url" '{QueueUrl: $url, VisibilityTimeout: 300}')")
handle=$(jq -r '.Messages[0].ReceiptHandle' <<<"$received")
event=$(jq -nc --arg body "$job" --arg handle "$handle" --arg account "$account" '{Records: [{messageId: "image-test", receiptHandle: $handle,
  body: $body, md5OfBody: "", messageAttributes: {}, eventSource: "aws:sqs",
  eventSourceARN: "arn:aws:sqs:us-east-1:\($account):redmine-jobs", awsRegion: "us-east-1"}]}')
# After the job, redmine_aws_sqs deletes the message at
# REDMINE_JOBS_QUEUE_URL (the emulator here), not at the public host the gem
# builds from the ARN, which the internal network does not reach. The runtime
# may write the job's log after the invocation returns, so the log is read for
# a few seconds.
job_logged() {
  for _ in $(seq 1 10); do
    docker logs "$prefix-worker" 2>&1 | grep -q 'Running job: .*\[DestroyProjectJob\]' && return 0
    sleep 1
  done
  return 1
}
worker_runs() {
  local response
  response=$(invoke worker "$event")
  # A success is the handler's string ("Processed 1 jobs."); an error is an
  # object with errorType.
  if ! jq -e 'type == "string"' <<<"$response" >/dev/null 2>&1 || ! job_logged; then
    echo "$response" >&2
    docker logs "$prefix-worker" 2>&1 | tail -20 >&2
    return 1
  fi
}
check "worker runs a job from an SQS event" worker_runs
project_deleted() {
  task '{"command":"runner","args":["puts Project.where(identifier: %q(worker-probe)).count"]}' | tail -n 1 | grep -qx 0
}
check "the job deleted the project" project_deleted
# The received message was in flight; deleted, nothing is left in flight.
message_deleted() {
  queue_attribute ApproximateNumberOfMessagesNotVisible | grep -qx 0
}
check "the worker deleted the message" message_deleted
queued() {
  queue_attribute ApproximateNumberOfMessages | grep -qvx 0
}
check "the job queued its notification mail in SQS" queued
not_allowed() {
  local response
  response=$(invoke worker "$(jq -c '.Records[0].body |= (fromjson | .job_class = "ApplicationJob" | tojson)' <<<"$event")")
  grep -q 'not in the configured job_class_allowlist' <<<"$response"
}
check "a job class outside the allowlist is not run" not_allowed

echo
if [[ "$failures" -gt 0 ]]; then
  echo "$failures check(s) failed" >&2
  exit 1
fi
echo "all image checks passed"
