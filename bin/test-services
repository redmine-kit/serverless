#!/usr/bin/env bash
# Starts the services that the tests use (PostgreSQL 16 and AWS Emulator,
# bin/lib/aws-emulator.sh) in Apple container when it runs, else in Docker
# (CONTAINER_CLI=container|docker chooses), and checks that each answers, and
# that AWS cannot be reached from the emulator's network. Later stages run
# their tests against them.
#   bin/test-services          # start, check and keep them running
#   bin/test-services --down   # stop them
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/lib/container.sh
. bin/lib/aws-emulator.sh

if [[ "${1:-}" == "--down" ]]; then
  services_down
  exit 0
fi

services_up

echo "== PostgreSQL"
psql -U postgres -v ON_ERROR_STOP=1 -q -t -A -c 'SELECT version()'

echo "== AWS Emulator"
"$cli" exec "$(emulator)" aws-emulator --version | sed -n 's/^Version: /AWS Emulator /p'
sqs ListQueues '{}' >/dev/null
echo "SQS answers"
aws_unreachable "$(emulator)"
echo "AWS cannot be reached from the internal network"
