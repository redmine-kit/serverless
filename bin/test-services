#!/usr/bin/env bash
# Starts the services that the tests use (PostgreSQL 16 and AWS Emulator,
# test/compose.yml) and checks that each answers, and that AWS cannot be
# reached from the emulator's network. Later stages run their tests against
# them.
#   bin/test-services          # start, check and keep them running
#   bin/test-services --down   # stop them
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/lib/aws-emulator.sh

if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi

if ! "${compose[@]}" up -d --build --wait; then
  "${compose[@]}" ps -a
  "${compose[@]}" logs --tail 80
  exit 1
fi

psql() { "${compose[@]}" exec -T postgres psql -v ON_ERROR_STOP=1 -q -t -A "$@"; }

echo "== PostgreSQL"
psql -U postgres -c 'SELECT version()'

echo "== AWS Emulator"
docker exec "$(emulator)" aws-emulator --version | sed -n 's/^Version: /AWS Emulator /p'
sqs ListQueues '{}' >/dev/null
echo "SQS answers"
aws_unreachable "$(emulator)"
echo "AWS cannot be reached from the internal network"
