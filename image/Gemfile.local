# frozen_string_literal: true

# Gems added to Redmine for running on Lambda (docs/lambda.md). Redmine's
# Gemfile loads this file. Gems used only by the plugin go in its Gemfile.
# Redmine lists puma only in its test group. Bundler warns that it is listed
# twice; this entry puts it in the default group too.
gem 'puma'
# The Redmine Serverless plugins, as gems from GitHub Packages
# (docs/architecture.md#distribution). Installing from there needs a token
# with read:packages (bin/lib/plugin.sh). The image links each installed gem
# into plugins/, where Redmine loads plugins from. Bundler requires the gems
# that must act before Rails initializes: redmine_serverless_ssm reads SSM
# Parameter Store before Rails reads the configuration, and the boot/ files of
# redmine_serverless (the /events middleware), redmine_serverless_sqs (the
# queue adapter) and redmine_serverless_ses (the SES delivery method). Redmine
# loads redmine_serverless_s3 from plugins/ like any plugin.
source 'https://rubygems.pkg.github.com/redmine-kit' do
  gem 'redmine_serverless_ssm', '>= 0.1.1'
  gem 'redmine_serverless', '>= 0.2.0'
  gem 'redmine_serverless_sqs', '>= 0.1.3'
  gem 'redmine_serverless_ses', '>= 0.2.0'
  gem 'redmine_serverless_s3', '>= 0.2.0', require: false
end
