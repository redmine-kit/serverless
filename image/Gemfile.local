# frozen_string_literal: true

# Gems added to Redmine for running on Lambda (docs/lambda.md). Redmine's
# Gemfile loads this file. Gems used only by the plugin go in its Gemfile.
# Redmine lists puma only in its test group. Bundler warns that it is listed
# twice; this entry puts it in the default group too.
gem 'puma'

# The Redmine Kit AWS plugins, from their Git repositories
# (docs/architecture.md#distribution), at the commits that image/Gemfile.lock
# names (bin/update-gems). Public repositories: no credential is needed. The
# main branch until the plugins have releases, then their version tags. The
# image links each installed gem into plugins/, where Redmine loads plugins
# from. Bundler requires the gems that must act before Rails initializes:
# redmine_kit_aws_ssm reads SSM Parameter Store before Rails reads the
# configuration, and the boot/ files of redmine_kit_aws_lambda (the /events
# middleware), redmine_kit_aws_sqs (the queue adapter) and redmine_kit_aws_ses
# (the SES delivery method). Redmine loads redmine_kit_aws, which every other
# plugin requires, and redmine_kit_aws_s3 from plugins/ like any plugin.
# A local checkout in vendor/plugin-overrides/<gem> (bin/lib/plugin.sh)
# replaces a gem, for working on several repositories at once.
{
  'redmine_kit_aws' => ['redmine_aws', { require: false }],
  'redmine_kit_aws_ssm' => ['redmine_aws_ssm', {}],
  'redmine_kit_aws_lambda' => ['redmine_aws_lambda', {}],
  'redmine_kit_aws_sqs' => ['redmine_aws_sqs', {}],
  'redmine_kit_aws_ses' => ['redmine_aws_ses', {}],
  'redmine_kit_aws_s3' => ['redmine_aws_s3', { require: false }]
}.each do |name, (repository, options)|
  override = File.expand_path("vendor/plugin-overrides/#{name}", __dir__)
  if File.directory?(override)
    gem name, path: override, **options
  else
    gem name, git: "https://github.com/redmine-kit/#{repository}.git", branch: 'main', **options
  end
end
