{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redmine-kit/serverless/schema/redmine.schema.json",
  "title": "redmine.json",
  "description": "The configuration of one Redmine instance for bin/deploy (docs/deploy-config.md#fields-of-redminejson).",
  "type": "object",
  "additionalProperties": false,
  "required": ["region", "deployRoleArn", "domain", "database"],
  "properties": {
    "$schema": { "type": "string" },
    "instance": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,19}$", "default": "redmine" },
    "region": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" },
    "deployRoleArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$" },
    "domain": { "type": "string", "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$" },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["route53", "external"], "default": "route53" },
        "hostedZoneId": { "type": "string", "pattern": "^Z[A-Z0-9]+$" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["endpoints", "nat"], "default": "endpoints" },
        "shared": { "const": true, "default": true }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["majorVersion"],
      "properties": {
        "majorVersion": { "type": "string", "pattern": "^[0-9]{2}$" },
        "instanceClass": { "type": "string", "pattern": "^db\\.[a-z0-9]+\\.[a-z0-9]+$", "default": "db.t4g.micro" },
        "storageGb": { "type": "integer", "minimum": 20, "default": 20 }
      }
    },
    "lambda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webMemoryMb": { "type": "integer", "minimum": 512, "maximum": 10240, "default": 2048 },
        "webReservedConcurrency": { "type": "integer", "minimum": 0, "default": 10 },
        "workerReservedConcurrency": { "type": "integer", "minimum": 0, "default": 3 },
        "warmup": { "const": false, "default": false }
      }
    },
    "uploads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1, "default": 104857600 }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receive": { "type": "boolean", "default": true },
        "perProjectAddresses": { "type": "boolean", "default": false },
        "globalLocalPart": { "type": "string", "pattern": "^[a-z0-9._-]+$", "default": "redmine" }
      }
    },
    "webhooks": { "type": "boolean", "default": false },
    "cloudfront": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": { "enum": ["free", "pro", "payg"], "default": "free" },
        "webAclArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:wafv2:us-east-1:[0-9]{12}:global/webacl/.+$" }
      }
    },
    "waf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loginRateLimit": { "type": "integer", "minimum": 10, "default": 20 },
        "rateLimit": { "type": "integer", "minimum": 10, "default": 1000 },
        "commonRuleSet": { "enum": ["count", "block"], "default": "count" },
        "commonRuleSetCountOnly": {
          "type": "array", "items": { "type": "string" }, "maxItems": 1,
          "default": ["SizeRestrictions_BODY"]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "repository": { "type": "string", "default": "ghcr.io/redmine-kit/serverless" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "redmine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "array"] } },
        "settingsMode": { "enum": ["initial", "enforce"], "default": "initial" },
        "pluginSettings": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": { "type": "string", "default": "UTC" },
        "sendReminders": { "type": "boolean", "default": false }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retentionDays": { "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653], "default": 90 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordsDays": { "type": "integer", "minimum": 1, "default": 90 },
        "mailDays": { "type": "integer", "minimum": 1, "default": 30 },
        "noncurrentVersionDays": { "type": "integer", "minimum": 1, "default": 30 },
        "backupDays": { "type": "integer", "minimum": 1, "maximum": 35, "default": 7 }
      }
    },
    "alarms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snsTopicArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:sns:[a-z0-9-]+:[0-9]{12}:.+$" }
      }
    },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "dns": { "properties": { "mode": { "const": "route53" } } } } },
      "then": { "properties": { "dns": { "required": ["hostedZoneId"] } }, "required": ["dns"] }
    }
  ]
}
