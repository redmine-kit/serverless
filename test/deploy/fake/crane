#!/usr/bin/env bash
# A fake crane for test/deploy/run.sh: records each call in $FAKE/calls.
set -euo pipefail
printf 'crane %s\n' "$*" >>"$FAKE/calls"
case "$1" in
  # A derived image's tarball has the digest d…d, an image in a registry b…b.
  digest)
    if [[ "$2" == --tarball ]]; then
      echo "sha256:$(printf 'd%.0s' {1..64})"
    else
      echo "sha256:$(printf 'b%.0s' {1..64})"
    fi ;;
  auth) cat >/dev/null ;;
  copy) ;;
  push) echo "${3%:*}@sha256:$(printf 'd%.0s' {1..64})" ;;
  # The image's file system: only the assets matter.
  export)
    dir=$(mktemp -d)
    mkdir -p "$dir/var/task/redmine/public/assets"
    echo 'body {}' >"$dir/var/task/redmine/public/assets/application-0123.css"
    tar -c -C "$dir" var
    rm -rf "$dir" ;;
  *) echo "fake crane: unexpected call: $*" >&2; exit 2 ;;
esac
